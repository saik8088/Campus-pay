# CampusPay Server — Environment Variables Example
# Copy this file to .env and fill in real values.
# Never commit a .env file with real secrets.

PORT=5000

# MongoDB connection string — get this from MongoDB Atlas or local MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campuspay?retryWrites=true&w=majority

# JWT secret — use a long, random string in production
JWT_SECRET=replace_with_a_long_random_string_in_production

# JWT expiry
JWT_EXPIRES_IN=7d

# Allowed frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

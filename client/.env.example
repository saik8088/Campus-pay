# CampusPay Client — Environment Variables Example
# Copy this file to .env and fill in real values.
# Never commit a .env file with real secrets.

# API URL — leave empty to use Vite proxy (recommended for local dev)
# VITE_API_URL=http://localhost:5000/api

# For production on Vercel, set this to your Render backend URL:
# VITE_API_URL=https://your-app.onrender.com/api
